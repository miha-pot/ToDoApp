@page "/login"

<MudGrid Justify="Justify.Center" Style="min-height: 85vh; align-items: center; padding: 16px;">
    <MudItem xs="12" sm="8" md="5" lg="4">

        @if (_isCheckingAuth)
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        }
        else
        {
            <MudCard Elevation="4" Style="width: 100%; max-width: 450px;" Class="pa-6 rounded-lg">
                <MudCardContent>
                    <div style="text-align: center;" class="mb-6">
                        <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.h5" Class="fw-bold text-primary">Prijava v sistem</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">Vnesite podatke za dostop do proizvodnega portala</MudText>
                    </div>

                    <MudForm @ref="_form" Model="@_model" Validation="@(_validator.ValidateValue())">

                        <MudTextField T="string"
                                      Label="E-poštni naslov"
                                      @bind-Value="_model.Email"
                                      Variant="Variant.Outlined"
                                      For="@(()=>_model.Email)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Clear"
                                      OnAdornmentClick="@(() => _model.Email = string.Empty)"
                                      Immediate="true"
                                      Class="mb-4" />

                        <MudTextField T="string"
                                      Label="Geslo"
                                      @bind-Value="_model.Password"
                                      Variant="Variant.Outlined"
                                      For="@(()=>_model.Password)"
                                      InputType="@_passwordInput"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@_passwordInputIcon"
                                      OnAdornmentClick="TogglePasswordVisibility"
                                      Immediate="true"
                                      Class="mb-4" />
                               
                        <MudStack Row="true" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       FullWidth="true"
                                       OnClick="ClearFields">
                                Počisti
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       Disabled="@_isSubmitting"
                                       OnClick="HandleLogin"
                                       Class="rounded-pill py-3">
                                @if (_isSubmitting)
                                {
                                    <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                                    <MudText>Preverjanje...</MudText>
                                }
                                else
                                {
                                    <MudText>Prijavi se</MudText>
                                }
                            </MudButton>
                        </MudStack>
                    </MudForm>

                    <ApiErrorAlert Response="@_apiResponse" />
                </MudCardContent>
            </MudCard>
        }
    </MudItem>
</MudGrid>