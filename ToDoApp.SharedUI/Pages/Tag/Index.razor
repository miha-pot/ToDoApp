@page "/tag"
@page "/tag/index"

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-16 my-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mud-w-100 px-2 mb-4">

        <MudText Typo="Typo.h5" Class="mud-typography-weight-bold text-primary ma-0">
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="me-2 mb-1" Size="Size.Medium" />
            Tag management
        </MudText>

        <MudSpacer />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NavigateToCreate"
                   Class="rounded-pill px-6">
            Novo
        </MudButton>

    </MudStack>

    <MudTable T="TagResponse" ServerData="LoadServerData"
              Hover="true"
              Bordered="false"
              Striped="true"
              Elevation="2"
              Breakpoint="Breakpoint.Sm"
              Class="rounded-lg mt-2"
              @ref="_table">

        <ToolBarContent>
            <MudGrid Spacing="2" Class="align-center w-100 pa-1">
                <MudItem xs="8" sm="5">
                    <MudTextField T="string"
                                  ValueChanged="@OnSearchChanged"
                                  Placeholder="Išči po naslovu..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Clearable="true"
                                  FullWidth="true"
                                  DebounceInterval="500" />
                </MudItem>               
            </MudGrid>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel T="TagResponse" SortLabel="Name">Naslov</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: right;">Akcije</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Color" Class="fw-semibold">
                <MudChip T="string"
                         Style="@($"color: {context.ColorHex}; background-color: {context.BgColorHex}; font-weight: bold; font-size: 1.1rem; padding: 18px 24px;")">
                    @context.Name
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Akcije" Class="text-sm-right text-start">
                <div class="d-inline-flex gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Medium" OnClick="() => NavigateToEdit(context.Id)" Class="pa-2" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Medium" OnClick="() => RequestDeleteAsync(context.Id, context.Name!)" Class="pa-2" />
                </div>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Align="Align.Center" Class="p-4 text-muted">No tags found.</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText Align="Align.Center" Class="p-4 text-muted">Loading server data...</MudText>
        </LoadingContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Vrstic:"
                           HideRowsPerPage="true"
                           InfoFormat="{first_item}-{last_item} od {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>