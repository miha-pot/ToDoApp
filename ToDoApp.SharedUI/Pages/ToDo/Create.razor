@page "/todo/create"
@using ToDoApp.Shared.TagDTO.Queries

@inject IToDoService _toDoService
@inject ITagService _tagService
@inject ISnackbar Snackbar

@implements IDisposable

<MudGrid Justify="Justify.Center" Style="min-height: 85vh; align-items: center; padding: 16px;">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudCard Elevation="3" Class="rounded-lg">

            <MudCardHeader Style="background-color: var(--mud-palette-primary); color: white;" Class="py-4">
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Inherit" />
                        <MudText Typo="Typo.h6" Style="font-weight: 600;">Dodaj Novo Opravilo</MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pa-6">
                <MudForm @ref="_form" Model="@_model" Validation="@(_validator.ValidateValue())">

                    <MudGrid Spacing="3">

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Title"
                                          Label="Naslov opravila"
                                          Variant="Variant.Outlined"
                                          Placeholder="Npr. Pripravi poročilo..."
                                          For="@(() => _model.Title)"
                                          Immediate="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Description"
                                          Label="Opis opravila"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          Placeholder="Podrobnejši opis opravila..."
                                          For="@(() => _model.Description)"
                                          Immediate="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_model.DueDate"
                                           Label="Rok za izvedbo"
                                           Editable="true"
                                           Variant="Variant.Outlined"
                                           Placeholder="Izberite datum..."
                                           For="@(() => _model.DueDate)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="Priority"
                                       @bind-Value="_model.Level"
                                       Label="Prioriteta / Nivo"
                                       Variant="Variant.Outlined"
                                       For="@(() => _model.Level)">
                                @foreach (Priority lvl in Enum.GetValues(typeof(Priority)))
                                {
                                    <MudSelectItem Value="@lvl">@lvl.GetDisplayName()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" Class="py-0">
                            <MudSwitch @bind-Value="_model.IsCompleted"
                                       Color="Color.Primary"
                                       Label="Označi kot zaključeno"
                                       Style="font-weight: 600;" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="TagResponse"
                                       Label="Oznake (Tagi)"
                                       MultiSelection="true"
                                       @bind-SelectedValues="_selectedTags"
                                       MultiSelectionTextFunc="GetMultiSelectionText"
                                       Variant="Variant.Outlined"
                                       AdornmentIcon="@Icons.Material.Filled.Label"
                                       AnchorOrigin="Origin.BottomCenter">

                                @foreach (var tag in _tagList)
                                {
                                    <MudSelectItem T="TagResponse" Value="@tag">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Style="@($"color: {tag.ColorHex}; background-color: {tag.BgColorHex}; font-weight: bold;")">
                                            @tag.Name
                                        </MudChip>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (_selectedTags != null && _selectedTags.Any())
                        {
                            <MudItem xs="12" Class="d-flex flex-wrap gap-2 mt-n2">
                                @foreach (var tag in _selectedTags)
                                {
                                    <MudChip T="string"
                                             OnClose="() => RemoveTag(tag)"
                                             Style="@($"color: {tag.ColorHex}; background-color: {tag.BgColorHex}; font-weight: bold;")">
                                        @tag.Name
                                    </MudChip>
                                }
                            </MudItem>
                        }

                    </MudGrid>
                </MudForm>

                @if (!_response.IsSuccess)
                {
                    <div class="mt-4">
                        <ApiErrorAlert Response="@_response" />
                    </div>
                }
            </MudCardContent>

            <MudCardActions Class="d-flex justify-end gap-2 pa-6 border-top">
                <MudButton Variant="Variant.Text"
                           OnClick="Cancel"
                           Disabled="@_isSubmitting"
                           Class="px-6 rounded-pill">
                    Prekliči
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleValidSubmit"
                           Disabled="@_isSubmitting"
                           Class="px-6 rounded-pill">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                        <span>Shranjevanje...</span>
                    }
                    else
                    {
                        <span>Shrani Opravilo</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public Guid? ParentToDoId { get; set; }

    private MudForm _form = null!;
    private ToDoAddRequest _model = new();
    private ToDoAddRequestValidator _validator = new();

    private bool _isSubmitting;
    private readonly CancellationTokenSource _cts = new();
    private ApiResponse<ToDoResponse> _response = ApiResponse<ToDoResponse>.Empty();
    private List<TagResponse> _tagList = [];
    private IReadOnlyCollection<TagResponse> _selectedTags { get; set; } = new List<TagResponse>();

    protected override async Task OnInitializedAsync()
    {
        _model.ParentToDoId = ParentToDoId;
        _tagList = await _tagService.GetActiveTags(_cts.Token);
    }

    private string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        return selectedValues.Count == 0
            ? "Ni izbranih oznak"
            : $"Izbrano ({selectedValues.Count})";
    }

    private void RemoveTag(TagResponse tag)
    {
        var list = _selectedTags.ToList();
        list.Remove(tag);
        _selectedTags = list;
    }

    private async Task HandleValidSubmit()
    {
        _response = ApiResponse<ToDoResponse>.Empty();

        _model.TagIds = _selectedTags.Select(x => x.Id).ToList();

        // 1. Ročno sprožimo MudBlazor validacijo forme pred pošiljanjem
        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            Snackbar.Add("Obrazec ni veljaven. Preverite vnešene podatke.", MudBlazor.Severity.Error);
            return;
        }

        _isSubmitting = true;

        var result = await _toDoService.CreateAsync(_model, _cts.Token);
        _response = result;

        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/todo");
        }
        else
        {


            // Če strežnik vrne specifične napake, jih lahko preko _response preslikaš na formo
            // (Odvisno od tega, kako imaš nastavljen ApplyServerErrors)
        }

        _isSubmitting = false;
    }

    private void Cancel() => NavigationManager.NavigateTo("/todo");
        
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}