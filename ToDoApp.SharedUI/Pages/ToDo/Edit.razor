@page "/todo/edit/{id:guid}"
@page "/todo/edit/{id:guid}/{previousLocation}/{parentId:guid?}"
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-10 pt-md-16 my-4">
    <MudGrid Justify="Justify.Center" Class="px-2">

        @if (!_isLoaded)
        {
            <MudItem xs="12" Class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12" sm="10" md="7" lg="6">
                <MudCard Elevation="4" Class="rounded-lg border-light">

                    @* Glava kartice - Popolnoma usklajena s Create pogledom *@
                    <MudCardHeader Class="px-6 py-5 border-bottom">
                        <CardHeaderContent>
                            <div class="d-flex align-center gap-3">
                                <div class="icon-container rounded-lg pa-2 bg-primary-light">
                                    <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" Size="Size.Medium" />
                                </div>
                                <div>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Uredi opravilo</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">Posodobite podrobnosti in status obstoječega delovnega naloga.</MudText>
                                </div>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pa-6">
                        <MudForm @ref="_form" Model="@_model" Validation="@(_validator.ValidateValue())">
                            <MudGrid Spacing="3">

                                @* Naslov opravila *@
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.Title"
                                                  Label="Naslov opravila"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="Npr. Pregled CNC stroja..."
                                                  For="@(() => _model.Title)"
                                                  Immediate="true"
                                                  Margin="Margin.Dense" />
                                </MudItem>

                                @* Opis *@
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.Description"
                                                  Label="Podroben opis"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Vpišite natančna navodila ali opombe glede opravila..."
                                                  For="@(() => _model.Description)"
                                                  Immediate="true" />
                                </MudItem>

                                @* Rok izvedbe *@
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker @bind-Date="_model.DueDate"
                                                   Label="Rok izvedbe"
                                                   Editable="true"
                                                   Variant="Variant.Outlined"
                                                   Placeholder="Izberite datum..."
                                                   For="@(() => _model.DueDate)"
                                                   Margin="Margin.Dense"
                                                   IconSize="Size.Small" />
                                </MudItem>

                                @* Prioriteta *@
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="Priority"
                                               @bind-Value="_model.Level"
                                               Label="Nivo prioritete"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               For="@(() => _model.Level)">
                                        @foreach (Priority lvl in Enum.GetValues(typeof(Priority)))
                                        {
                                            <MudSelectItem Value="@lvl">@lvl.GetDisplayName()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                @* Stikalo za status zaključenosti (Success barva za zaključeno) *@
                                <MudItem xs="12" Class="py-1">
                                    <div class="switch-container rounded-lg pa-2 border-dashed">
                                        <MudSwitch @bind-Value="_model.IsCompleted"
                                                   Color="Color.Success"
                                                   Label="Označi to opravilo kot zaključeno"
                                                   Class="font-weight-semibold ma-0" />
                                    </div>
                                </MudItem>

                                @* Izbira oznak *@
                                <MudItem xs="12">
                                    <MudSelect T="TagResponse"
                                               Label="Oznake / Delovne skupine"
                                               MultiSelection="true"
                                               @bind-SelectedValues="SelectedTags"
                                               MultiSelectionTextFunc="GetMultiSelectionText"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               AdornmentIcon="@Icons.Material.Filled.Label"
                                               AdornmentColor="Color.Primary"
                                               AnchorOrigin="Origin.BottomCenter">
                                        @foreach (var tag in _tagList)
                                        {
                                            <MudSelectItem T="TagResponse" Value="@tag">
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Style="@($"color: {tag.ColorHex}; background-color: {tag.BgColorHex}; font-weight: bold; border-radius: 4px;")">
                                                    @tag.Name
                                                </MudChip>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                @* Prikaz izbranih oznak (Chips) *@
                                @if (SelectedTags != null && SelectedTags.Any())
                                {
                                    <MudItem xs="12" Class="d-flex flex-wrap gap-2 mt-n1">
                                        @foreach (var tag in SelectedTags)
                                        {
                                            <MudChip T="string"
                                                     OnClose="() => RemoveTag(tag)"
                                                     Size="Size.Small"
                                                     Variant="Variant.Filled"
                                                     Style="@($"color: {tag.ColorHex}; background-color: {tag.BgColorHex}; font-weight: bold; border-radius: 4px;")">
                                                @tag.Name
                                            </MudChip>
                                        }
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudForm>

                        @if (!_response.IsSuccess)
                        {
                            <div class="mt-4 animate-fade-in">
                                <ApiErrorAlert Response="@_response" />
                            </div>
                        }
                    </MudCardContent>

                    @* Akcije z odzivnim prelomom in ustreznim ozadjem *@
                    <MudCardActions Class="pa-6 border-top bg-light-grey actions-layout">
                        <MudButton Variant="Variant.Text"
                                   OnClick="Cancel"
                                   Disabled="@_isSubmitting"
                                   Class="px-6 rounded-pill btn-mobile-order-2">
                            Prekliči
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="HandleValidSubmit"
                                   Disabled="@_isSubmitting"
                                   Class="px-6 rounded-pill mud-elevation-2 btn-mobile-order-1">
                            @if (_isSubmitting)
                            {
                                <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                                <span>Shranjevanje...</span>
                            }
                            else
                            {
                                <span>Shrani spremembe</span>
                            }
                        </MudButton>
                    </MudCardActions>

                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<style>
    .font-weight-bold {
        font-weight: 600;
    }

    .font-weight-semibold {
        font-weight: 500;
    }

    .text-muted {
        color: var(--mud-palette-text-secondary);
    }

    .border-bottom {
        border-bottom: 1px solid var(--mud-palette-background-grey);
    }

    .border-top {
        border-top: 1px solid var(--mud-palette-background-grey);
    }

    .border-light {
        border: 1px solid var(--mud-palette-background-grey);
    }

    .bg-primary-light {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.08);
    }

    .bg-light-grey {
        background-color: var(--mud-palette-background-grey);
    }

    .border-dashed {
        border: 1px dashed var(--mud-palette-divider);
    }

    .switch-container {
        background-color: rgba(var(--mud-palette-success-rgb), 0.03);
    }

    /* 🟢 ODZIVNI PRELOM (RESPONSIVE) ZA GUMBE */
    .actions-layout {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    @@media (max-width: 600px) {
        .actions-layout {
            flex-direction: column; /* Gumba se postavita drug pod drugega na telefonu */
            width: 100%;
        }

            .actions-layout .MudButton {
                width: 100% !important; /* Gumba zavzameta celotno širino */
                justify-content: center;
            }
        /* Pametni vrstni red na telefonu: Primarna akcija gre na vrh, Prekliči pa spodaj */
        .btn-mobile-order-1 {
            order: 1;
        }

        .btn-mobile-order-2 {
            order: 2;
        }
    }
</style>