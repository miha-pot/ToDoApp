@inherits LayoutComponentBase

@inject IDataStorage _localStorage
@inject LanguageState LangState

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <NavMenu @bind-IsDarkMode="@_isDarkMode" OnDrawerToggle="DrawerToggle" />

    <LeftMenu SideMenuOpen="@_drawerOpen" SideMenuOpenChanged="OnDrawerOpenChanged" />
    <MudMainContent Class="pa-4 pb-16">
        @Body
    </MudMainContent>

    <Footer />
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _isInitialized = false;

    private const string ThemeKey = "themeMode";
    private const string DrawerKey = "drawer_open_state";

    private MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Blue.Default,
            Surface = "#1e1e1e",
            Background = "#121212",
            BackgroundGray = "#272727",
            AppbarText = Colors.Shades.White,
            AppbarBackground = "#1e1e1e",
            DrawerBackground = "#1e1e1e",
            DrawerText = Colors.Shades.White,
            TextPrimary = Colors.Shades.White,
            TextSecondary = Colors.Gray.Lighten2
        },
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Blue.Default,
            AppbarText = Colors.Shades.Black,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Gray.Darken2,
            AppbarBackground = Colors.LightBlue.Lighten5
        }
    };

    private async Task DrawerToggle()
    {
        await OnDrawerOpenChanged(!_drawerOpen);
    }

    private async Task OnDrawerOpenChanged(bool value)
    {
        _drawerOpen = value;
        if (_isInitialized)
        {
            await _localStorage.SetItemAsync(DrawerKey, value);
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var storedTheme = await _localStorage.GetItemAsync<string>(ThemeKey);
                if (!string.IsNullOrEmpty(storedTheme))
                {
                    _isDarkMode = storedTheme == "dark";
                }

                var storedDrawer = await _localStorage.GetItemAsync<bool?>(DrawerKey);
                _drawerOpen = storedDrawer ?? true;

                _isInitialized = true;

                StateHasChanged();
            }
            catch
            {
                _isInitialized = true;
            }
        }
    }
}
