@using ToDoApp.SharedUI.States
@inject IDataStorage _localStorage
@inject IAuthService _authService

@inject NavigationManager NavigationManager
@inject LanguageState LangState

<MudAppBar Elevation="1" Color="Color.Primary">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="OnDrawerToggle" />
    <MudText Typo="Typo.h5" Class="ml-3">Task manager</MudText>

    <MudSpacer />

    <MudMenu StartIcon="@Icons.Material.Filled.Language"
             Label="@LangState.CurrentLanguage.ToUpper()"
             Color="Color.Inherit"
             Variant="Variant.Text">
        <MudMenuItem OnClick="@(() => ChangeLanguage("sl"))">SLO</MudMenuItem>
        <MudMenuItem OnClick="@(() => ChangeLanguage("en"))">ENG</MudMenuItem>
        <MudMenuItem OnClick="@(() => ChangeLanguage("de"))">DEU</MudMenuItem>
    </MudMenu>

    <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.NightsStay)"
                   Color="Color.Inherit"
                   OnClick="ToggleTheme"
                   Class="me-2" />

    <AuthorizeView Context="authContext">
        <Authorized>
            <MudMenu @ref="_accountMenu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                   Color="Color.Inherit"
                                   Size="Size.Large"
                                   OnClick="@(args => _accountMenu!.ToggleMenuAsync(args))">
                    </MudIconButton>

                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2" style="min-width: 160px;">
                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@authContext.User.Identity?.Name  </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Logged in</MudText>
                    </div>
                    <MudDivider />

                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync" IconColor="Color.Error">
                        <MudText Color="Color.Error">Logout</MudText>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </Authorized>

        <NotAuthorized>
            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       Href="/login"
                       StartIcon="@Icons.Material.Filled.Login"
                       Class="rounded-pill px-5 me-3 fw-semibold hover-subtle">
                Login
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Href="/register"
                       StartIcon="@Icons.Material.Filled.AppRegistration"
                       Class="rounded-pill px-5 fw-bold hover-lift">
                Register
            </MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback<bool> IsDarkModeChanged { get; set; }
    [Parameter] public EventCallback OnDrawerToggle { get; set; }
    private MudMenu? _accountMenu;

    private async Task ChangeLanguage(string cultureCode)
    {
        await LangState.SetLanguageAsync(cultureCode);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private async Task ToggleTheme()
    {
        bool newMode = !IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(newMode);
        await _localStorage.SetItemAsync("themeMode", newMode ? "dark" : "light");
    }

    private async Task LogoutAsync()
    {
        await _authService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}