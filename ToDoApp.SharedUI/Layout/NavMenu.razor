@using ToDoApp.SharedUI.States
@inject IDataStorage _localStorage
@inject IAuthService _authService
@inject LanguageState LangState

@implements IDisposable

<MudAppBar Elevation="1" Color="Color.Primary" Class="px-2 px-sm-4">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="OnDrawerToggle" />

    <MudText Typo="Typo.h6" Class="ml-2 ml-sm-3 d-none d-sm-block">Task manager</MudText>
    <MudText Typo="Typo.h6" Class="ml-2 d-sm-none">TM</MudText>

    <MudSpacer />

    <MudMenu StartIcon="@Icons.Material.Filled.Language"
             Color="Color.Inherit"
             Variant="Variant.Text"
             Class="me-1">
        <MudMenuItem OnClick="@(() => ChangeLanguage("sl"))">
            <MudText Style="@(LangState.CurrentLanguage == "sl" ? "font-weight:700;" : "")">SLO</MudText>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => ChangeLanguage("en"))">
            <MudText Style="@(LangState.CurrentLanguage == "en" ? "font-weight:700;" : "")">ENG</MudText>
        </MudMenuItem>
        <MudMenuItem OnClick="@(() => ChangeLanguage("de"))">
            <MudText Style="@(LangState.CurrentLanguage == "de" ? "font-weight:700;" : "")">DEU</MudText>
        </MudMenuItem>
    </MudMenu>

    <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.NightsStay)"
                   Color="Color.Inherit"
                   OnClick="ToggleTheme"
                   Class="me-1 me-sm-2" />

    <AuthorizeView Context="authContext">
        <Authorized>
            <MudMenu @ref="_accountMenu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                   Color="Color.Inherit"
                                   Size="Size.Large"
                                   OnClick="@(args => _accountMenu!.ToggleMenuAsync(args))" />
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2" style="min-width: 160px;">
                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@authContext.User.Identity?.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Logged in</MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync" IconColor="Color.Error">
                        <MudText Color="Color.Error">Logout</MudText>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </Authorized>

        <NotAuthorized>
            <MudIconButton Icon="@Icons.Material.Filled.Login"
                           Color="Color.Inherit"
                           Href="/login"
                           Class="d-sm-none" />
            <MudIconButton Icon="@Icons.Material.Filled.AppRegistration"
                           Color="Color.Inherit"
                           Href="/register"
                           Class="d-sm-none ms-1" />

            <MudButton Variant="Variant.Text"
                       Color="Color.Inherit"
                       Href="/login"
                       StartIcon="@Icons.Material.Filled.Login"
                       Class="d-none d-sm-inline-flex rounded-pill px-5 me-3 fw-semibold hover-subtle">
                Login
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Href="/register"
                       StartIcon="@Icons.Material.Filled.AppRegistration"
                       Class="d-none d-sm-inline-flex rounded-pill px-5 fw-bold hover-lift">
                Register
            </MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public EventCallback<bool> IsDarkModeChanged { get; set; }
    [Parameter] public EventCallback OnDrawerToggle { get; set; }
    private MudMenu? _accountMenu;
    CancellationTokenSource _cts = new CancellationTokenSource();

    private async Task ChangeLanguage(string cultureCode)
    {
        await LangState.SetLanguageAsync(cultureCode);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private async Task ToggleTheme()
    {
        bool newMode = !IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(newMode);
        await _localStorage.SetItemAsync("themeMode", newMode ? "dark" : "light");
    }

    private async Task LogoutAsync()
    {
        await _authService.LogoutAsync(_cts.Token);

        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}